# ============================================================================
# TUIOS
# TUIOS terminal window manager, with completions generated by the tool itself.
# ============================================================================
_: {
  den.aspects.tuios = {user, ...}: {
    # Keep TUIOS configuration and saved sessions across root rollbacks.
    homePersistence = {
      inherit (user) userName;
      directories = [
        ".config/tuios"
        ".local/state/tuios"
      ];
    };

    homeManager = {
      lib,
      pkgs,
      ...
    }: {
      home.packages = [pkgs.tuios];

      # TUIOS can emit its own Fish completion script at build time.
      xdg.configFile."fish/completions/tuios.fish".source = pkgs.runCommandLocal "tuios-fish-completions" {} ''
        ${lib.getExe pkgs.tuios} completion fish > $out
      '';
    };
  };
}
